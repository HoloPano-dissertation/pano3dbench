{
  "experiment_name": "smoke",
  "seed": 42,
  "output_dir": "../../artifacts/smoke",
  "model": {
    "type": "fixture",
    "parameters": {
      "prediction_dir": "scene/predictions"
    }
  },
  "dataset": {
    "type": "manifest",
    "parameters": {
      "manifest": "scene/manifest.jsonl"
    }
  },
  "metrics": [
    {
      "type": "layout_iou_3d"
    },
    {
      "type": "object_map",
      "parameters": {
        "iou_threshold": 0.5
      }
    },
    {
      "type": "collision_rate"
    }
  ]
}
